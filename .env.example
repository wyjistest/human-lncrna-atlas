# Root environment file template (for docker-compose)
# ===============================================
# Copy to `.env` and fill required values before running:
#   docker compose up -d
#
# Notes:
# - `TRUSTED_HOSTS` and `CORS_ORIGINS` must be valid JSON arrays (FastAPI settings will JSON-parse them).
# - Do NOT commit real secrets (DB_PASSWORD / ADMIN_API_KEY).
# - SECURITY: 生产环境不要设置 SECURITY_ALLOW_INSECURE=true（后端启动会直接拒绝）。

# Backend mode
ENV=production

# PostgreSQL (used by docker-compose postgres + backend)
DB_USER=lncrna
DB_NAME=lncrna_production
DB_PASSWORD=CHANGE_ME

# Optional: DB connection pool tuning (生产环境可按并发调参)
# DB_POOL_SIZE=20
# DB_POOL_MAX_OVERFLOW=30
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=1800

# Admin API Key (required in production; generate with: openssl rand -hex 32)
ADMIN_REQUIRE_API_KEY=true
ADMIN_API_KEY=CHANGE_ME

# Host/CORS allowlists (JSON arrays)
TRUSTED_HOSTS=["your-domain.com"]
# If behind a reverse proxy (nginx/traefik), trust ONLY the proxy IP(s) to parse X-Forwarded-For safely (JSON array)
# TRUSTED_PROXIES=["<reverse-proxy-ip>"]
CORS_ORIGINS=["https://your-domain.com"]

# Optional: reduce attack surface (disable /docs, /redoc, /openapi.json)
# ENABLE_API_DOCS=false

# Optional: DoS guardrails (application-level backstops)
# MAX_REQUEST_BODY_SIZE=1048576
# MAX_QUERY_STRING_LENGTH=8192

# Optional: Materialized view refresh timeout (seconds) for Admin endpoint
# MV_REFRESH_TIMEOUT=600

# Optional: request logging tuning (高 QPS 建议开启慢请求阈值或降低采样率)
# REQUEST_LOG_ENABLED=true
# REQUEST_LOG_SLOW_THRESHOLD_MS=200
# REQUEST_LOG_SAMPLE_RATE=0.1
# REQUEST_LOG_MAX_URL_LENGTH=2048
# LOG_LEVEL=INFO

# Optional: Redis reconnect backoff seconds
REDIS_CONNECT_BACKOFF_SECONDS=30

# Optional: SlowAPI rate limit storage (defaults to redis service if not set)
RATELIMIT_STORAGE_URL=redis://redis:6379/1
# RATELIMIT_KEY_PREFIX=lncrna_atlas
# RATE_LIMIT_BYPASS_PRIVATE=false

# Optional: Prometheus metrics (protected by API key via middleware)
# ENABLE_METRICS=true

# Optional: HSTS (only enable after HTTPS is fully configured)
# ENABLE_HSTS=false
# HSTS_MAX_AGE=31536000
# HSTS_INCLUDE_SUBDOMAINS=true
# HSTS_PRELOAD=false

# Optional: IGV genomes static file service (mount /genomes)
# GENOMES_DIR=/data/genomes
