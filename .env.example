# Root environment file template (for docker-compose)
# ===============================================
# Copy to `.env` and fill required values before running:
#   docker compose up -d
#
# Notes:
# - `TRUSTED_HOSTS` and `CORS_ORIGINS` must be valid JSON arrays (FastAPI settings will JSON-parse them).
# - Do NOT commit real secrets (DB_PASSWORD / ADMIN_API_KEY).

# Backend mode
ENV=production

# PostgreSQL (used by docker-compose postgres + backend)
DB_USER=lncrna
DB_NAME=lncrna_production
DB_PASSWORD=CHANGE_ME

# Admin API Key (required in production; generate with: openssl rand -hex 32)
ADMIN_API_KEY=CHANGE_ME

# Host/CORS allowlists (JSON arrays)
TRUSTED_HOSTS=["your-domain.com"]
CORS_ORIGINS=["https://your-domain.com"]

# Optional: Redis reconnect backoff seconds
REDIS_CONNECT_BACKOFF_SECONDS=30

# Optional: SlowAPI rate limit storage (defaults to redis service if not set)
RATELIMIT_STORAGE_URL=redis://redis:6379/1

