# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_USER=amax
DB_PASSWORD=
DB_NAME=lncrna_production

# Redis配置（可选）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# CORS配置（JSON 数组格式）
# 生产环境请替换为实际的前端域名
CORS_ORIGINS=["http://localhost:5173", "http://localhost:5174", "http://localhost:3000", "http://127.0.0.1:5173"]

# 缓存配置
CACHE_TTL=3600
ENABLE_CACHE=true

# 日志级别
LOG_LEVEL=INFO

# 查询超时（秒）
QUERY_TIMEOUT=30

# 基因组文件目录 (IGV 浏览器使用)
# 如果未设置或目录不存在，IGV 基因组文件服务将被禁用
GENOMES_DIR=/opt/lncrna/genomes

# ETL 数据目录 (数据导入脚本使用)
# 用于 import_sequences.py 等脚本查找源数据文件
# 必填：未设置时导入脚本将报错
LNCRNA_DATA_PATH=/opt/lncrna/data
