# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_USER=amax
DB_PASSWORD=
DB_NAME=lncrna_production

# Redis配置（可选）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
