# 环境模式配置（Phase 9.18）
# production: 严格模式，DB连接失败时拒绝启动
# development: 宽松模式，DB连接失败时仍启动
ENV=development

# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_USER=amax
DB_PASSWORD=
DB_NAME=lncrna_production

# 数据库连接池配置（可选，使用默认值适合大多数场景）
# DB_POOL_SIZE=10             # 连接池大小（默认 10，生产环境建议 20）
# DB_POOL_MAX_OVERFLOW=20     # 超出 pool_size 后最多创建的连接数（默认 20，生产环境建议 30）
# DB_POOL_TIMEOUT=30          # 获取连接超时（秒）
# DB_POOL_RECYCLE=1800        # 连接回收时间（秒，默认 30 分钟）

# Redis配置（可选）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# CORS配置（JSON 数组格式）
# 生产环境请替换为实际的前端域名
# Phase 9.18: 增强URL校验，禁止通配符'*'，强制http/https scheme
CORS_ORIGINS=["http://localhost:5173", "http://localhost:5174", "http://localhost:3000", "http://127.0.0.1:5173"]

# TrustedHost配置（JSON 数组格式）
# 防止 HTTP Host Header 攻击
# 生产环境请替换为实际的域名
TRUSTED_HOSTS=["localhost", "127.0.0.1", "*.localhost"]

# 缓存配置
CACHE_TTL=3600
ENABLE_CACHE=true

# 日志级别
LOG_LEVEL=INFO

# 请求日志配置（可选）
# REQUEST_LOG_ENABLED=true          # 是否启用请求日志
# REQUEST_LOG_SLOW_THRESHOLD_MS=0   # 仅记录慢请求阈值（毫秒），0 表示记录全部
# REQUEST_LOG_SAMPLE_RATE=1.0       # 采样率 0.0-1.0（生产环境可设为 0.1 = 10%）
# REQUEST_LOG_MAX_URL_LENGTH=2048   # 请求日志中 URL 最大长度（0=不限制）

# 查询超时（秒）
QUERY_TIMEOUT=30

# 基因组文件目录 (IGV 浏览器使用)
# 如果未设置或目录不存在，IGV 基因组文件服务将被禁用
#
# ⚠️ SECURITY WARNING:
#   /genomes 端点会暴露此目录下的所有文件（递归）。
#   请确保该目录仅包含公开的基因组数据文件（.fa, .fai, .cytoband 等）。
#   不要在此目录中放置配置文件、私有数据或可执行文件。
#   建议使用专用目录，不与其他数据混放。
GENOMES_DIR=/opt/lncrna/genomes

# ETL 数据目录 (数据导入脚本使用)
# 用于 import_sequences.py 等脚本查找源数据文件
# 必填：未设置时导入脚本将报错
LNCRNA_DATA_PATH=/opt/lncrna/data

# ============================================================================
# Admin API 安全配置
# ============================================================================

# Admin API 密钥（生产环境必需）
# 用于保护 /admin/* 端点，如数据库管理、缓存清理等敏感操作
# 示例：openssl rand -hex 32 生成随机密钥
ADMIN_API_KEY=

# ⚠️ 生产环境必须设为 true（严格模式）
# 严格模式：所有 Admin API 请求必须提供有效 API Key
# - false: 私网 IP 自动放行 + API Key 可选（仅限本地开发）
# - true: 无条件要求 API Key（推荐生产，防止反向代理/内网绕过攻击）
# 🔐 安全警告：false 模式在生产环境存在严重安全风险
ADMIN_REQUIRE_API_KEY=true

# ============================================================================
# 反向代理与限流配置
# ============================================================================

# 可信代理 IP 列表（JSON 数组格式）
# 配置后，系统会从 X-Forwarded-For 头获取真实客户端 IP
# 示例：["10.0.0.1", "192.168.1.0/24"]
TRUSTED_PROXIES=[]

# 私网 IP 是否绕过限流（默认 false）
# 注意：仅在确认私网安全时启用，避免内网 DoS 风险
RATE_LIMIT_BYPASS_PRIVATE=false

# SlowAPI 限流存储后端（生产环境强烈建议配置 Redis）
# 说明：
# - slowapi 默认使用 memory://（不跨进程/多 worker 共享），生产环境多 worker 会导致限流失真
# - 推荐使用 Redis，并使用独立 DB（例如 /1）避免与业务缓存混用
# 示例：
#   RATELIMIT_STORAGE_URL=redis://:password@redis:6379/1
#   RATELIMIT_STORAGE_URL=redis://redis:6379/1
RATELIMIT_STORAGE_URL=

# SlowAPI 限流 Key 前缀（用于避免不同服务/环境键冲突）
RATELIMIT_KEY_PREFIX=lncrna_atlas
