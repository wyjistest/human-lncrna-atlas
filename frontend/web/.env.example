# Human LncRNA Atlas Frontend Environment Configuration
# =====================================================
# Copy this file to .env.development or .env.production and modify as needed.

# ===================
# API Base URL
# ===================
# Local development (default for .env.development):
VITE_API_BASE_URL=http://localhost:8000

# Production deployment (use your server IP/domain):
# VITE_API_BASE_URL=https://your-domain.com/api

# External access via frp/reverse proxy:
# VITE_API_BASE_URL=http://<YOUR_PROXY_IP>:<PORT>

# ===================
# Mock Service Worker
# ===================
# Set to 'true' to enable MSW for frontend-only development
# Set to 'false' to use real backend API
VITE_USE_MOCK=false

# ===================
# Admin API Authentication
# ===================
# ⚠️ SECURITY WARNING ⚠️
# This key is embedded in the frontend build and visible to anyone who can access
# the admin page. Only use in ONE of these scenarios:
#   1. Admin page is only accessible from internal network/VPN
#   2. Reverse proxy (Nginx) injects X-Admin-API-Key header instead
#   3. Development/testing environment only
#
# For public internet deployments, use backend session-based authentication instead.
#
# API Key for Admin endpoints (monitoring, cache management)
# Required when backend has ADMIN_REQUIRE_API_KEY=true (default in production)
# Generate with: openssl rand -hex 32
# VITE_ADMIN_API_KEY=your_admin_api_key_here
