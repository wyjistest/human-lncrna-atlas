# Human LncRNA Atlas Frontend Environment Configuration
# =====================================================
# Copy this file to .env.development or .env.production and modify as needed.

# ===================
# API Base URL
# ===================
# Local development (default for .env.development):
VITE_API_BASE_URL=http://localhost:8000

# Production deployment (use your server IP/domain):
# VITE_API_BASE_URL=https://your-domain.com/api

# External access via frp proxy:
# VITE_API_BASE_URL=http://45.62.117.191:6004

# ===================
# Mock Service Worker
# ===================
# Set to 'true' to enable MSW for frontend-only development
# Set to 'false' to use real backend API
VITE_USE_MOCK=false
