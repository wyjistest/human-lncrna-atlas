# Development Environment Configuration
# =====================================
# See .env.example for all available options and documentation.

# API Base URL - Default to localhost for local development
# Change to external IP if accessing backend via frp proxy:
# VITE_API_BASE_URL=http://45.62.117.191:6004
VITE_API_BASE_URL=http://localhost:8000

# MSW Configuration (Mock Service Worker)
# Set to 'true' to enable frontend-only development with mock data
VITE_USE_MOCK=false
