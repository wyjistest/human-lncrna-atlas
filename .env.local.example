# Local environment file template (for docker-compose)
# ====================================================
# Copy to `.env` and fill required values before running:
#   cp .env.local.example .env
#   docker compose up -d
#
# Notes:
# - `TRUSTED_HOSTS` and `CORS_ORIGINS` must be valid JSON arrays (FastAPI settings will JSON-parse them).
# - Do NOT commit real secrets (DB_PASSWORD / ADMIN_API_KEY).
# - `.env.example` 保持生产 fail-fast 安全默认；本文件仅用于本机 localhost/127.0.0.1 最短路径。

# Backend mode
ENV=production

# PostgreSQL (used by docker-compose postgres + backend)
DB_USER=lncrna
DB_NAME=lncrna_production
DB_PASSWORD=

# Admin API Key (generate with: openssl rand -hex 32)
ADMIN_REQUIRE_API_KEY=true
ADMIN_API_KEY=

# Host/CORS allowlists (JSON arrays)
TRUSTED_HOSTS=["localhost","127.0.0.1","*.localhost"]

# 本机前端常用端口：Vite dev 默认 5173；端口被占用时可能自动切到 5174。
# 如你使用 `vite preview` 或自定义端口，请把这里同步加上对应 origin。
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://127.0.0.1:5174"]

